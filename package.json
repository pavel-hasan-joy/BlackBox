{
  "name": "blackbox-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BlackBox: Production Failure Recorder & Incident Intelligence Platform",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*",
    "benchmarks"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "benchmark": "npm run benchmark --workspace=benchmarks",
    "dev": "npm run dev --workspaces --parallel"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "tsx": "^4.19.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
